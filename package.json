{
  "name": "task-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply task-arcade-db --local",
    "db:remote": "wrangler d1 migrations apply task-arcade-db --remote",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.mjs",
    "rename": "node scripts/rename.mjs",
    "build": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
